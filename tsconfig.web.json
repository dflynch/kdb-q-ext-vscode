{
  // The webview's script, and the codec and the formatter it will share with
  // the extension, mustn't use Node: this checks them without Node's types
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": [],
    "lib": ["ES2024", "DOM"],
    "noEmit": true
  },
  "include": ["src/codec", "src/format", "src/webview"],
  "exclude": []
}
