{
  "name": "kdb-q-ext-vscode",
  "displayName": "Quirk: kdb+/q toolkit",
  "description": "A lightweight extension for kdb+/q programming",
  "icon": "./icons/quirk.png",
  "version": "1.1.0",
  "publisher": "dflynch3",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/dflynch/kdb-q-ext-vscode"
  },
  "engines": {
    "vscode": "^1.140.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "q",
        "extensions": [
          ".q"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/q-light.svg",
          "dark": "./icons/q-dark.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "q",
        "scopeName": "source.q",
        "path": "./syntaxes/q.tmGrammar.json"
      }
    ],
    "commands": [
      {
        "command": "kdb-q-ext-vscode.runSelectedText",
        "category": "kdb+/q",
        "title": "Run Selected Text in Terminal"
      },
      {
        "command": "kdb-q-ext-vscode.runOnServer",
        "category": "kdb+/q",
        "title": "Run Selected Text on Server"
      },
      {
        "command": "kdb-q-ext-vscode.runFileOnServer",
        "category": "kdb+/q",
        "title": "Run File on Server",
        "icon": "$(play)"
      },
      {
        "command": "kdb-q-ext-vscode.toggleBlockComment",
        "category": "kdb+/q",
        "title": "Toggle Block Comment"
      },
      {
        "command": "kdb-q-ext-vscode.addServer",
        "category": "kdb+/q",
        "title": "Add Server"
      },
      {
        "command": "kdb-q-ext-vscode.connect",
        "category": "kdb+/q",
        "title": "Connect to Server"
      },
      {
        "command": "kdb-q-ext-vscode.disconnect",
        "category": "kdb+/q",
        "title": "Disconnect from Server"
      },
      {
        "command": "kdb-q-ext-vscode.showServerMenu",
        "category": "kdb+/q",
        "title": "Show Server Menu"
      },
      {
        "command": "kdb-q-ext-vscode.openSettings",
        "category": "kdb+/q",
        "title": "Open Settings"
      },
      {
        "command": "kdb-q-ext-vscode.setPassword",
        "category": "kdb+/q",
        "title": "Set Server Password"
      },
      {
        "command": "kdb-q-ext-vscode.clearPassword",
        "category": "kdb+/q",
        "title": "Clear Server Password"
      },
      {
        "command": "kdb-q-ext-vscode.setPassphrase",
        "category": "kdb+/q",
        "title": "Set Certificate Passphrase"
      },
      {
        "command": "kdb-q-ext-vscode.clearPassphrase",
        "category": "kdb+/q",
        "title": "Clear Certificate Passphrase"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "kdb-q-ext-vscode.runSelectedText",
          "when": "editorLangId == q"
        },
        {
          "command": "kdb-q-ext-vscode.runOnServer",
          "when": "editorLangId == q"
        },
        {
          "command": "kdb-q-ext-vscode.runFileOnServer",
          "when": "editorLangId == q"
        },
        {
          "command": "kdb-q-ext-vscode.toggleBlockComment",
          "when": "!editorReadonly && editorLangId == q"
        },
        {
          "command": "kdb-q-ext-vscode.showServerMenu",
          "when": "false"
        }
      ],
      "editor/title/run": [
        {
          "command": "kdb-q-ext-vscode.runFileOnServer",
          "when": "editorLangId == q"
        }
      ],
      "editor/context": [
        {
          "command": "kdb-q-ext-vscode.runOnServer",
          "when": "editorLangId == q",
          "group": "kdb-q@1"
        },
        {
          "command": "kdb-q-ext-vscode.runFileOnServer",
          "when": "editorLangId == q",
          "group": "kdb-q@2"
        },
        {
          "command": "kdb-q-ext-vscode.runSelectedText",
          "when": "editorLangId == q",
          "group": "kdb-q@3"
        }
      ]
    },
    "keybindings": [
      {
        "command": "kdb-q-ext-vscode.runOnServer",
        "key": "ctrl+enter",
        "mac": "cmd+enter",
        "when": "editorTextFocus && editorLangId == q"
      },
      {
        "command": "kdb-q-ext-vscode.runSelectedText",
        "key": "shift+enter",
        "when": "editorTextFocus && editorLangId == q && !suggestWidgetVisible"
      },
      {
        "command": "kdb-q-ext-vscode.toggleBlockComment",
        "key": "shift+alt+a",
        "when": "editorTextFocus && !editorReadonly && editorLangId == q"
      }
    ],
    "configuration": {
      "title": "kdb+/q",
      "properties": {
        "kdb-q-ext-vscode.servers": {
          "type": "object",
          "default": {},
          "markdownDescription": "The kdb+ processes to connect to, by name: add one with **kdb+/q: Add Server**. Passwords aren't kept here: set one with **kdb+/q: Set Server Password**, which keeps it in VS Code's secure storage for the user, host and port, or have it come from elsewhere with `auth`.",
          "additionalProperties": {
            "type": "object",
            "required": [
              "host",
              "port"
            ],
            "additionalProperties": false,
            "properties": {
              "host": {
                "type": "string",
                "minLength": 1,
                "description": "The host name or address."
              },
              "port": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535,
                "description": "The port."
              },
              "user": {
                "type": "string",
                "pattern": "^[^:\\u0000]*$",
                "description": "The user to log in as."
              },
              "timeout": {
                "type": "integer",
                "minimum": 0,
                "description": "How long to wait to connect and log in, in milliseconds, overriding the connect timeout. 0 waits as long as it takes, as hopen does."
              },
              "protect": {
                "type": "boolean",
                "default": true,
                "markdownDescription": "Run each query under `.Q.trp`, so that an error comes back with its backtrace and its full text. The query is sent as written, as a list with the function that traps it, for q's default `.z.pg` to evaluate. Turn this off for a server whose `.z.pg` is customised or only takes strings, such as a gateway."
              },
              "tls": {
                "markdownDescription": "Connect with TLS, as `tcps://` in q: `true`, or the files it needs besides the system's. The server's certificate is checked against the system's CAs and Node's, and any `ca` given. A client certificate's passphrase is kept by **kdb+/q: Set Certificate Passphrase**. Paths are absolute or start with `~/`.",
                "oneOf": [
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "ca": {
                        "type": "string",
                        "pattern": "^(\\/|\\\\\\\\|[A-Za-z]:[\\\\/]|~[\\\\/])",
                        "description": "A CA certificate to trust as well as the system's, in PEM, such as a firm's own."
                      },
                      "cert": {
                        "type": "string",
                        "pattern": "^(\\/|\\\\\\\\|[A-Za-z]:[\\\\/]|~[\\\\/])",
                        "description": "A client certificate in PEM, for a server that requires one. Goes with key."
                      },
                      "key": {
                        "type": "string",
                        "pattern": "^(\\/|\\\\\\\\|[A-Za-z]:[\\\\/]|~[\\\\/])",
                        "description": "The client certificate's private key in PEM, encrypted or not."
                      },
                      "pfx": {
                        "type": "string",
                        "pattern": "^(\\/|\\\\\\\\|[A-Za-z]:[\\\\/]|~[\\\\/])",
                        "description": "A client certificate and its key in one PKCS#12 file, instead of cert and key."
                      }
                    }
                  }
                ]
              },
              "auth": {
                "markdownDescription": "Where the password comes from, when it isn't the one kept by **kdb+/q: Set Server Password**: `\"prompt\"` asks for it at every connect and doesn't keep it, where a password can't be stored or changes too often to keep; `{ \"extension\": \"publisher.name\", … }` asks that extension at every connect, for a firm's own sign-on. The rest of the object goes to the extension.",
                "oneOf": [
                  {
                    "const": "prompt",
                    "description": "Ask for the password at every connect, and don't keep it."
                  },
                  {
                    "type": "object",
                    "required": [
                      "extension"
                    ],
                    "properties": {
                      "extension": {
                        "type": "string",
                        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9-]*\\.[a-zA-Z0-9][a-zA-Z0-9-]*$",
                        "description": "The ID of the extension that gives the credentials."
                      }
                    },
                    "description": "Ask an extension for the credentials at every connect."
                  }
                ]
              }
            }
          }
        },
        "kdb-q-ext-vscode.connectTimeout": {
          "type": "integer",
          "default": 2000,
          "minimum": 0,
          "markdownDescription": "How long to wait for a server to connect and log in, in milliseconds, as `hopen` takes. 0 waits as long as it takes, as `hopen` does without one."
        },
        "kdb-q-ext-vscode.consoleSize": {
          "type": "array",
          "default": [
            1000,
            1000
          ],
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "integer",
            "minimum": 10,
            "maximum": 2000
          },
          "markdownDescription": "How much of a result **Run Selected Text on Server** shows, as lines then width, as q's `\\c` takes them. A result with more lines shows the first of them and then `..`, and a wider line is cut, ending in `..`."
        },
        "kdb-q-ext-vscode.sizeLimit": {
          "type": "number",
          "default": 10,
          "exclusiveMinimum": 0,
          "markdownDescription": "The largest result to take, in megabytes, uncompressed. A larger one is refused and the connection closed. Results are held in the extension host, whose memory can't be raised, and some decode to up to 60 times their size, so a high limit can crash every extension in the window."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "clean": "node -e \"require('node:fs').rmSync('out', { recursive: true, force: true })\"",
    "compile": "npm run clean && tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "biome check && tsc -p tsconfig.web.json",
    "test": "vscode-test",
    "package": "vsce package",
    "format": "biome check --write",
    "fixtures": "cd test/fixtures && q fixtures.q -q",
    "fuzz": "npm run compile && node test/fuzz/fuzz.js"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.19.2",
    "@types/vscode": "1.140.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "typescript": "^7.0.2",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  }
}
