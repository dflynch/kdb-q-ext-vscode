{
  "name": "q",
  "scopeName": "source.q",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#commands"
    },
    {
      "include": "#expression"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "include": "#blockComment"
        },
        {
          "name": "comment.block.eof.q",
          "begin": "^\\\\\\s*$"
        },
        {
          "name": "comment.line.slash.q",
          "match": "(?:(?<=[ \\t])|(?<!.))\\/.*"
        }
      ]
    },
    "blockComment": {
      "name": "comment.block.q",
      "begin": "^\\/\\s*$",
      "end": "^\\\\\\s*$",
      "patterns": [
        {
          "include": "#blockComment"
        }
      ]
    },
    "expression": {
      "patterns": [
        {
          "include": "#lambdas"
        },
        {
          "include": "#casts"
        },
        {
          "include": "#strings"
        },
        {
          "include": "#keywords"
        },
        {
          "include": "#literals"
        },
        {
          "include": "#namespaces"
        },
        {
          "include": "#variables"
        },
        {
          "include": "#punctuation"
        }
      ]
    },
    "commands": {
      "patterns": [
        {
          "match": "^(\\\\(?:l|cd|[12_]))(?=\\s|$).*",
          "captures": {
            "1": {
              "name": "meta.preprocessor.system.q"
            }
          }
        },
        {
          "begin": "^(\\\\(?:ts|[abBcCdefgopPrsStTuvwWxz\\\\])(?::\\d+)?)(?=\\s|$)",
          "beginCaptures": {
            "1": {
              "name": "meta.preprocessor.system.q"
            }
          },
          "end": "$",
          "patterns": [
            {
              "include": "#comments"
            },
            {
              "include": "#expression"
            }
          ]
        },
        {
          "match": "^(\\\\[A-Za-z_][\\w.-]*)(?=\\s|$).*",
          "captures": {
            "1": {
              "name": "meta.preprocessor.system.q"
            }
          }
        },
        {
          "match": "^(k\\)).*",
          "captures": {
            "1": {
              "name": "meta.preprocessor.language.q"
            }
          }
        }
      ]
    },
    "lambdas": {
      "patterns": [
        {
          "begin": "\\{(?!\\s*\\[)",
          "end": "\\}",
          "patterns": [
            {
              "name": "variable.parameter.implicit.q",
              "match": "(?<![\\w.`])[xyz](?![\\w.])"
            },
            {
              "include": "$self"
            }
          ]
        },
        {
          "begin": "\\{(?=\\s*\\[)",
          "end": "\\}",
          "patterns": [
            {
              "include": "$self"
            }
          ]
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.q",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.q",
              "match": "\\\\(?:[\"\\\\nrt]|[0-3][0-7]{2})"
            }
          ]
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.import.q",
          "match": "\\buse(?![\\w.])"
        },
        {
          "name": "keyword.control.conditional.q",
          "match": "\\bif(?![\\w.])"
        },
        {
          "name": "keyword.control.conditional.q",
          "match": "[$?](?=\\s*\\[)"
        },
        {
          "name": "keyword.control.loop.q",
          "match": "\\b(?:do|while)(?![\\w.])"
        },
        {
          "name": "keyword.control.flow.q",
          "match": "\\bexit(?![\\w.])"
        },
        {
          "name": "keyword.control.flow.signal.q",
          "match": "(?<![^\\s\\[(;{])'(?![:\\[])"
        },
        {
          "name": "keyword.operator.iterator.q",
          "match": "':|'|\\\\:|/:|/|\\\\"
        },
        {
          "name": "keyword.other.qsql.q",
          "match": "\\b(?:select|exec|update|delete|by|from|where)(?![\\w.])"
        },
        {
          "name": "support.function.builtin.io.q",
          "match": "(?<![\\w.])[012]:"
        },
        {
          "name": "support.function.builtin.internal.q",
          "match": "(?<![\\w)\\]}\"])-\\d+!"
        },
        {
          "name": "keyword.operator.arithmetic.q",
          "match": "(?<=[\\w)\\]}\"])-|-(?!\\.?\\d)|[+*%]"
        },
        {
          "name": "keyword.operator.comparison.q",
          "match": "<>|<=|>=|[=<>~]"
        },
        {
          "name": "keyword.operator.q",
          "match": "\\.(?![\\w.])|[@$!?&|#^,_]"
        },
        {
          "name": "support.function.builtin.q",
          "match": "\\b(?:each|over|scan|prior|peach|abs|acos|aj|aj0|ajf|ajf0|all|and|any|asc|asin|asof|atan|attr|avg|avgs|bin|binr|ceiling|cols|cor|cos|count|cov|cross|csv|cut|deltas|desc|dev|differ|distinct|div|dsave|ej|ema|enlist|eval|except|exp|fby|fills|first|fkeys|flip|floor|get|getenv|group|gtime|hclose|hcount|hdel|hopen|hsym|iasc|idesc|ij|ijf|in|insert|inter|inv|key|keys|last|like|lj|ljf|load|log|lower|lsq|ltime|ltrim|mavg|max|maxs|mcount|md5|mdev|med|meta|min|mins|mmax|mmin|mmu|mod|msum|neg|next|not|null|or|parse|pj|prd|prds|prev|rand|rank|ratios|raze|read0|read1|reciprocal|reval|reverse|rload|rotate|rsave|rtrim|save|scov|sdev|set|setenv|show|signum|sin|sqrt|ss|ssr|string|sublist|sum|sums|sv|svar|system|tables|tan|til|trim|type|uj|ujf|ungroup|union|upper|upsert|value|var|view|views|vs|wavg|within|wj|wj1|wsum|ww|xasc|xbar|xcol|xcols|xdesc|xexp|xgroup|xkey|xlog|xprev|xrank)(?![\\w.])"
        }
      ]
    },
    "literals": {
      "patterns": [
        {
          "name": "support.class.handle.q",
          "match": "`:[.:/\\w]*"
        },
        {
          "name": "storage.modifier.attribute.q",
          "match": "`[spgu]?(?=#)"
        },
        {
          "name": "constant.language.symbol.q",
          "match": "(?:`[.:\\w]*)+"
        },
        {
          "name": "constant.numeric.datetime.q",
          "match": "\\d{4}\\.\\d{2}\\.\\d{2}T(?:\\d{2}:){1,2}\\d{2}\\.?\\d*"
        },
        {
          "name": "constant.numeric.timestamp.q",
          "match": "\\d{4}\\.\\d{2}\\.\\d{2}D(?:\\d{2}(?::\\d{2}(?::\\d{2}(?:\\.\\d*)?)?)?)?"
        },
        {
          "name": "constant.numeric.date.q",
          "match": "\\d{4}\\.\\d{2}\\.\\d{2}"
        },
        {
          "name": "constant.numeric.month.q",
          "match": "\\d{4}\\.\\d{2}m"
        },
        {
          "name": "constant.numeric.timespan.q",
          "match": "-?\\d+D(?:\\d{2}(?::\\d{2}(?::\\d{2}(?:\\.\\d*)?)?)?)?"
        },
        {
          "name": "constant.numeric.time.q",
          "match": "-?(?:\\d{2}:){1,2}\\d{2}(?:\\.\\d*)?"
        },
        {
          "name": "constant.numeric.null.q",
          "match": "(?:0N[hijefcpmdznuvtg]?|0n)(?!\\w)"
        },
        {
          "name": "constant.numeric.infinity.q",
          "match": "-?(?:0W[hijefcpmdznuvt]?|0w)(?!\\w)"
        },
        {
          "name": "constant.numeric.boolean.q",
          "match": "[01]+b"
        },
        {
          "name": "constant.numeric.byte.q",
          "match": "0x[0-9a-fA-F]*"
        },
        {
          "name": "constant.numeric.number.q",
          "match": "-?(?:\\d+\\.\\d*|\\.\\d+|\\d+)(?:e[+-]?\\d+)?[cefhijnptuv]?"
        }
      ]
    },
    "namespaces": {
      "patterns": [
        {
          "name": "support.class.namespace.http.q",
          "match": "\\.h\\.(?:HOME|br|c0|c1|cd|code|d|data|eb|ec|ed|edsn|es|ex|fram|ha|hb|hc|he|hn|hnz|hp|hr|ht|hta|htac|htc|html|http|hu|hug|hy|iso8601|jx|ka|logo|nbr|pre|sa|sb|sc|td|text|tx|ty|uh|val|xd|xmp|xs|xt)\\b"
        },
        {
          "name": "support.class.namespace.json.q",
          "match": "\\.j\\.(?:J|e|es|j|jd|k|q|s)\\b"
        },
        {
          "name": "support.class.namespace.utilities.q",
          "match": "\\.Q\\.(?:A|Aa|BP|DL|IN|K|L|L1|Ll|Lp|Ls|Lu|Lx|M|MAP|S|V|a|a0|a1|a2|addmonths|addr|ajf0|an|atob|b6|bc|bd|bp|bs|bt|btoa|btx|bu|bv|bvfp|bvi|cN|cfg|chk|cn|d0|dbg|dd|def|dpft|dpfts|dpt|dpts|dr|dsftg|dt|dw|en|ens|enx|enxs|err|f|fc|ff|fk|fl|fln|fmt|fobj|foo|fp|fpn|fps|fqk|fql|fs|fsn|ft|fu|gc|gz|hap|hdpf|hg|hmb|host|hp|id|ind|ipc|j10|j12|jl8|jp|k|l|ld|li|lim|lo|lu|m|n|nA|nct|nv|o|objp|opt|ord|p|p1|p2|par|pcnt|pfc|pl|pl0|pm|prf0|prr|ps|pt|q0|qO|qa|qb|qd|qe|qk|qp|qt|res|rp|s|s1|s2|sbt|sha1|sp|srr|sw|sx|t|t0|tab|tel|trp|trpd|ts|tt|tx|ty|ua|unm|v|view|vt|w|x0|x1|x10|x12|x2|xy)\\b"
        },
        {
          "name": "support.class.namespace.dotz.q",
          "match": "\\.z\\.(?:A|D|H|K|M|N|P|T|W|X|Z|a|ac|b|bm|c|d|e|ex|exit|ey|f|h|i|k|l|m|n|o|p|pc|pd|pg|ph|pi|pm|po|pp|pq|ps|pw|q|r|s|t|ts|u|v|vs|w|wc|wo|ws|x|z|zd)\\b"
        }
      ]
    },
    "variables": {
      "patterns": [
        {
          "begin": "(?<=\\{)\\s*\\[",
          "end": "\\]",
          "patterns": [
            {
              "name": "variable.parameter.q",
              "match": "\\.?[a-zA-Z][a-zA-Z0-9_]*(?:\\.[a-zA-Z0-9_]+)*"
            },
            {
              "include": "#punctuation"
            }
          ]
        },
        {
          "match": "\\.?[a-zA-Z][a-zA-Z0-9_]*(?:\\.[a-zA-Z0-9_]+)*"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "keyword.operator.assignment.q",
          "match": "::?"
        },
        {
          "name": "punctuation.separator.q",
          "match": ";"
        }
      ]
    },
    "casts": {
      "patterns": [
        {
          "name": "support.type.cast.q",
          "match": "`(?:boolean|guid|byte|short|int|long|real|float|char|symbol|timestamp|month|date|datetime|timespan|minute|second|time|year|mm|dd|hh|uu|ss|week)?(?=\\$)"
        },
        {
          "name": "support.type.cast.q",
          "match": "\"[bcdefghijmnpstuvxzBCDEFGHIJMNPSTUVXZ*]\"(?=\\$)"
        },
        {
          "name": "support.type.cast.q",
          "match": "(?<![\\w.])\\d+h(?=\\$)"
        }
      ]
    }
  }
}
