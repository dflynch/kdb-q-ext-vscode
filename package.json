{
  "name": "kdb-q-ext-vscode",
  "displayName": "Quirk: kdb+/q toolkit",
  "description": "A lightweight extension for kdb+/q programming",
  "icon": "./icons/quirk.png",
  "version": "1.1.0",
  "publisher": "dflynch3",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/dflynch/kdb-q-ext-vscode"
  },
  "engines": {
    "vscode": "^1.140.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "q",
        "extensions": [
          ".q"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/q-light.svg",
          "dark": "./icons/q-dark.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "q",
        "scopeName": "source.q",
        "path": "./syntaxes/q.tmGrammar.json"
      }
    ],
    "commands": [
      {
        "command": "kdb-q-ext-vscode.runSelectedText",
        "category": "kdb+/q",
        "title": "Run Selected Text"
      },
      {
        "command": "kdb-q-ext-vscode.toggleBlockComment",
        "category": "kdb+/q",
        "title": "Toggle Block Comment"
      },
      {
        "command": "kdb-q-ext-vscode.setPassword",
        "category": "kdb+/q",
        "title": "Set Server Password"
      },
      {
        "command": "kdb-q-ext-vscode.clearPassword",
        "category": "kdb+/q",
        "title": "Clear Server Password"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "kdb-q-ext-vscode.runSelectedText",
          "when": "editorLangId == q"
        },
        {
          "command": "kdb-q-ext-vscode.toggleBlockComment",
          "when": "!editorReadonly && editorLangId == q"
        }
      ]
    },
    "keybindings": [
      {
        "command": "kdb-q-ext-vscode.runSelectedText",
        "key": "ctrl+enter",
        "mac": "cmd+enter",
        "when": "editorTextFocus && editorLangId == q"
      },
      {
        "command": "kdb-q-ext-vscode.toggleBlockComment",
        "key": "shift+alt+a",
        "when": "editorTextFocus && !editorReadonly && editorLangId == q"
      }
    ],
    "configuration": {
      "title": "kdb+/q",
      "properties": {
        "kdb-q-ext-vscode.servers": {
          "type": "object",
          "default": {},
          "markdownDescription": "The kdb+ processes to connect to, by name. Passwords aren't kept here: set one with **kdb+/q: Set Server Password**, which keeps it in VS Code's secure storage for the user, host and port, or have it come from elsewhere with `auth`.",
          "additionalProperties": {
            "type": "object",
            "required": [
              "host",
              "port"
            ],
            "additionalProperties": false,
            "properties": {
              "host": {
                "type": "string",
                "minLength": 1,
                "description": "The host name or address."
              },
              "port": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535,
                "description": "The port."
              },
              "user": {
                "type": "string",
                "pattern": "^[^:\\u0000]*$",
                "description": "The user to log in as."
              },
              "timeout": {
                "type": "integer",
                "minimum": 1,
                "description": "How long to wait to connect and log in, in milliseconds, overriding the connect timeout."
              },
              "protect": {
                "type": "boolean",
                "default": true,
                "markdownDescription": "Run each query under `.Q.trp`, so that an error comes back with its backtrace and its full text. The query is sent as written, as a list with the function that traps it, for q's default `.z.pg` to evaluate. Turn this off for a server whose `.z.pg` is customised or only takes strings, such as a gateway."
              },
              "auth": {
                "markdownDescription": "Where the password comes from, when it isn't the one kept by **kdb+/q: Set Server Password**: `\"prompt\"` asks for it at every connect and doesn't keep it, for a one-time code; `{ \"extension\": \"publisher.name\", … }` asks that extension at every connect, for a firm's own sign-on. The rest of the object goes to the extension.",
                "oneOf": [
                  {
                    "const": "prompt",
                    "description": "Ask for the password at every connect, and don't keep it."
                  },
                  {
                    "type": "object",
                    "required": [
                      "extension"
                    ],
                    "properties": {
                      "extension": {
                        "type": "string",
                        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9-]*\\.[a-zA-Z0-9][a-zA-Z0-9-]*$",
                        "description": "The ID of the extension that gives the credentials."
                      }
                    },
                    "description": "Ask an extension for the credentials at every connect."
                  }
                ]
              }
            }
          }
        },
        "kdb-q-ext-vscode.connectTimeout": {
          "type": "integer",
          "default": 2000,
          "minimum": 1,
          "markdownDescription": "How long to wait for a server to connect and log in, in milliseconds, as `hopen` takes."
        },
        "kdb-q-ext-vscode.sizeLimit": {
          "type": "number",
          "default": 10,
          "exclusiveMinimum": 0,
          "markdownDescription": "The largest result to take, in megabytes, uncompressed. A larger one is refused and the connection closed. Results are held in the extension host, whose memory can't be raised, and some decode to up to 60 times their size, so a high limit can crash every extension in the window."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "clean": "node -e \"require('node:fs').rmSync('out', { recursive: true, force: true })\"",
    "compile": "npm run clean && tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "biome check && tsc -p tsconfig.web.json",
    "test": "vscode-test",
    "package": "vsce package",
    "format": "biome check --write",
    "fixtures": "cd test/fixtures && q fixtures.q -q",
    "fuzz": "npm run compile && node test/fuzz/fuzz.js"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.19.2",
    "@types/vscode": "1.140.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "typescript": "^7.0.2",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  }
}
