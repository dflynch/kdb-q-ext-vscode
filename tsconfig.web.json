{
  // The webviews' scripts, and the codec, the formatter, the messages, the
  // login checks and protected evaluation they share with the extension,
  // mustn't use Node: this checks them without Node's types
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": [],
    "lib": ["ES2024", "DOM"],
    "noEmit": true
  },
  "include": [
    "src/codec",
    "src/form",
    "src/format",
    "src/login.ts",
    "src/messages.ts",
    "src/protection.ts",
    "src/webview"
  ],
  "exclude": []
}
