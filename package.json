{
  "name": "kdb-q-ext-vscode",
  "displayName": "Quirk: kdb+/q toolkit",
  "description": "A lightweight extension for kdb+/q programming",
  "icon": "./icons/quirk.png",
  "version": "1.1.0",
  "publisher": "dflynch3",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/dflynch/kdb-q-ext-vscode"
  },
  "engines": {
    "vscode": "^1.140.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "q",
        "extensions": [
          ".q"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/q-light.svg",
          "dark": "./icons/q-dark.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "q",
        "scopeName": "source.q",
        "path": "./syntaxes/q.tmGrammar.json"
      }
    ],
    "viewsContainers": {
      "panel": [
        {
          "id": "kdb-q-ext-vscode",
          "title": "kdb+/q",
          "icon": "icons/q-dark.svg"
        }
      ]
    },
    "views": {
      "kdb-q-ext-vscode": [
        {
          "type": "webview",
          "id": "kdb-q-ext-vscode.result",
          "name": "Result"
        }
      ]
    },
    "commands": [
      {
        "command": "kdb-q-ext-vscode.runFileOnServer",
        "category": "kdb+/q",
        "title": "Run File on Server",
        "icon": "$(play)"
      },
      {
        "command": "kdb-q-ext-vscode.runOnServer",
        "category": "kdb+/q",
        "title": "Run Selected Text on Server"
      },
      {
        "command": "kdb-q-ext-vscode.runSelectedText",
        "category": "kdb+/q",
        "title": "Run Selected Text in Terminal"
      },
      {
        "command": "kdb-q-ext-vscode.toggleBlockComment",
        "category": "kdb+/q",
        "title": "Toggle Block Comment"
      },
      {
        "command": "kdb-q-ext-vscode.addServer",
        "category": "kdb+/q",
        "title": "Add Server"
      },
      {
        "command": "kdb-q-ext-vscode.editServer",
        "category": "kdb+/q",
        "title": "Edit Server"
      },
      {
        "command": "kdb-q-ext-vscode.removeServer",
        "category": "kdb+/q",
        "title": "Remove Server"
      },
      {
        "command": "kdb-q-ext-vscode.keepResult",
        "category": "kdb+/q",
        "title": "Keep Result",
        "icon": "$(pin)",
        "enablement": "kdb-q-ext-vscode.hasResult"
      },
      {
        "command": "kdb-q-ext-vscode.exportResult",
        "category": "kdb+/q",
        "title": "Export Result to CSV",
        "icon": "$(export)",
        "enablement": "kdb-q-ext-vscode.exportable"
      },
      {
        "command": "kdb-q-ext-vscode.exportKept",
        "category": "kdb+/q",
        "title": "Export Kept Result to CSV",
        "icon": "$(export)",
        "enablement": "kdb-q-ext-vscode.keptExportable"
      },
      {
        "command": "kdb-q-ext-vscode.copyWithHeaders",
        "category": "kdb+/q",
        "title": "Copy with Headers"
      },
      {
        "command": "kdb-q-ext-vscode.connect",
        "category": "kdb+/q",
        "title": "Connect to Server"
      },
      {
        "command": "kdb-q-ext-vscode.disconnect",
        "category": "kdb+/q",
        "title": "Disconnect from Server"
      },
      {
        "command": "kdb-q-ext-vscode.showServerMenu",
        "category": "kdb+/q",
        "title": "Show Server Menu"
      },
      {
        "command": "kdb-q-ext-vscode.openSettings",
        "category": "kdb+/q",
        "title": "Open Settings"
      },
      {
        "command": "kdb-q-ext-vscode.setPassword",
        "category": "kdb+/q",
        "title": "Set Server Password"
      },
      {
        "command": "kdb-q-ext-vscode.clearPassword",
        "category": "kdb+/q",
        "title": "Clear Server Password"
      },
      {
        "command": "kdb-q-ext-vscode.setPassphrase",
        "category": "kdb+/q",
        "title": "Set Certificate Passphrase"
      },
      {
        "command": "kdb-q-ext-vscode.clearPassphrase",
        "category": "kdb+/q",
        "title": "Clear Certificate Passphrase"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "kdb-q-ext-vscode.runFileOnServer",
          "when": "editorLangId == q"
        },
        {
          "command": "kdb-q-ext-vscode.runOnServer",
          "when": "editorLangId == q"
        },
        {
          "command": "kdb-q-ext-vscode.runSelectedText",
          "when": "editorLangId == q"
        },
        {
          "command": "kdb-q-ext-vscode.toggleBlockComment",
          "when": "!editorReadonly && editorLangId == q"
        },
        {
          "command": "kdb-q-ext-vscode.showServerMenu",
          "when": "false"
        },
        {
          "command": "kdb-q-ext-vscode.exportKept",
          "when": "activeWebviewPanelId == kdb-q-ext-vscode.kept"
        },
        {
          "command": "kdb-q-ext-vscode.copyWithHeaders",
          "when": "false"
        }
      ],
      "webview/context": [
        {
          "command": "kdb-q-ext-vscode.copyWithHeaders",
          "when": "webviewSection == grid && (webviewId == kdb-q-ext-vscode.result || webviewId == kdb-q-ext-vscode.kept)",
          "group": "9_cutcopypaste"
        }
      ],
      "view/title": [
        {
          "command": "kdb-q-ext-vscode.exportResult",
          "when": "view == kdb-q-ext-vscode.result",
          "group": "navigation@1"
        },
        {
          "command": "kdb-q-ext-vscode.keepResult",
          "when": "view == kdb-q-ext-vscode.result",
          "group": "navigation@2"
        }
      ],
      "editor/title": [
        {
          "command": "kdb-q-ext-vscode.exportKept",
          "when": "activeWebviewPanelId == kdb-q-ext-vscode.kept",
          "group": "navigation"
        }
      ],
      "editor/title/run": [
        {
          "command": "kdb-q-ext-vscode.runFileOnServer",
          "when": "editorLangId == q"
        }
      ],
      "editor/context": [
        {
          "command": "kdb-q-ext-vscode.runFileOnServer",
          "when": "editorLangId == q",
          "group": "kdb-q@1"
        },
        {
          "command": "kdb-q-ext-vscode.runOnServer",
          "when": "editorLangId == q",
          "group": "kdb-q@2"
        },
        {
          "command": "kdb-q-ext-vscode.runSelectedText",
          "when": "editorLangId == q",
          "group": "kdb-q@3"
        }
      ]
    },
    "keybindings": [
      {
        "command": "kdb-q-ext-vscode.runOnServer",
        "key": "ctrl+enter",
        "mac": "cmd+enter",
        "when": "editorTextFocus && editorLangId == q"
      },
      {
        "command": "kdb-q-ext-vscode.runSelectedText",
        "key": "shift+enter",
        "when": "editorTextFocus && editorLangId == q && !suggestWidgetVisible"
      },
      {
        "command": "kdb-q-ext-vscode.toggleBlockComment",
        "key": "shift+alt+a",
        "when": "editorTextFocus && !editorReadonly && editorLangId == q"
      }
    ],
    "configuration": {
      "title": "kdb+/q",
      "properties": {
        "kdb-q-ext-vscode.servers": {
          "type": "object",
          "default": {},
          "markdownDescription": "The kdb+ processes to connect to, by name, in folders to any depth if you like: a server has fields, and a folder has none of its own, holding only servers and folders, or nothing. Add one with **kdb+/q: Add Server**. Passwords aren't kept here: set one with **kdb+/q: Set Server Password**, which keeps it in VS Code's secure storage for the user, host and port, or have it come from elsewhere with `auth`.",
          "propertyNames": {
            "pattern": "^[^/]*[^/\\s][^/]*$",
            "patternErrorMessage": "A name that isn't empty and has no /"
          },
          "additionalProperties": {
            "anyOf": [
              {
                "type": "object",
                "required": [
                  "host",
                  "port"
                ],
                "additionalProperties": false,
                "properties": {
                  "host": {
                    "type": "string",
                    "minLength": 1,
                    "description": "The host name or address."
                  },
                  "port": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 65535,
                    "description": "The port."
                  },
                  "user": {
                    "type": "string",
                    "pattern": "^[^:\\u0000]*$",
                    "description": "The user to log in as."
                  },
                  "timeout": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "How long to wait to connect and log in, in milliseconds. Unset or 0 waits as long as it takes, as hopen does."
                  },
                  "protect": {
                    "type": "boolean",
                    "default": true,
                    "markdownDescription": "Run each query under `.Q.trp`, so that an error comes back with its backtrace and its full text. The query is sent as written, as a list with the function that traps it, for q's default `.z.pg` to evaluate. Turn this off when the server enforces an allowlist: the query is then sent as a string."
                  },
                  "tls": {
                    "type": "boolean",
                    "markdownDescription": "Connect with TLS, as `tcps://` in q. The server's certificate is checked against the system's CAs and Node's, and `#kdb-q-ext-vscode.tlsCaFile#` if set; `#kdb-q-ext-vscode.tlsCertFile#` and `#kdb-q-ext-vscode.tlsKeyFile#` give a client certificate, for a server that requires one."
                  },
                  "auth": {
                    "enum": [
                      "prompt",
                      "extension"
                    ],
                    "enumDescriptions": [
                      "Ask for the password at every connect, and don't keep it.",
                      "Ask the extension in kdb-q-ext-vscode.authExtension for the credentials at every connect."
                    ],
                    "markdownDescription": "Where the password comes from, when it isn't the one kept by **kdb+/q: Set Server Password**: `\"prompt\"` asks for it at every connect and doesn't keep it, where a password can't be stored or changes too often to keep; `\"extension\"` asks the extension in `#kdb-q-ext-vscode.authExtension#` at every connect, for a firm's own sign-on."
                  }
                }
              },
              {
                "type": "object",
                "description": "A folder of servers, and of folders.",
                "propertyNames": {
                  "$ref": "#/properties/kdb-q-ext-vscode.servers/propertyNames"
                },
                "additionalProperties": {
                  "$ref": "#/properties/kdb-q-ext-vscode.servers/additionalProperties"
                }
              }
            ]
          }
        },
        "kdb-q-ext-vscode.authExtension": {
          "type": "string",
          "pattern": "^([a-zA-Z0-9][a-zA-Z0-9-]*\\.[a-zA-Z0-9][a-zA-Z0-9-]*)?$",
          "patternErrorMessage": "An extension ID: publisher.name",
          "default": "",
          "markdownDescription": "The extension that gives the credentials for a firm's own sign-on, as `publisher.name`, for the servers whose `auth` is `\"extension\"` It exports `credentials(request)`, given the server's name, its path such as `Prod/trades/TP`, and its host, port and user."
        },
        "kdb-q-ext-vscode.tlsCaFile": {
          "type": "string",
          "default": "",
          "pattern": "^$|^(\\/|\\\\\\\\|[A-Za-z]:[\\\\/]|~[\\\\/])",
          "patternErrorMessage": "An absolute path, or one from ~/",
          "markdownDescription": "A CA certificate in PEM to trust for TLS, as well as the system's and Node's, as q's `SSL_CA_CERT_FILE`. For every server with `tls`."
        },
        "kdb-q-ext-vscode.tlsCertFile": {
          "type": "string",
          "default": "",
          "pattern": "^$|^(\\/|\\\\\\\\|[A-Za-z]:[\\\\/]|~[\\\\/])",
          "patternErrorMessage": "An absolute path, or one from ~/",
          "markdownDescription": "A client certificate in PEM, for servers that require one, as q's `SSL_CERT_FILE`, with `#kdb-q-ext-vscode.tlsKeyFile#`. For every server with `tls`."
        },
        "kdb-q-ext-vscode.tlsKeyFile": {
          "type": "string",
          "default": "",
          "pattern": "^$|^(\\/|\\\\\\\\|[A-Za-z]:[\\\\/]|~[\\\\/])",
          "patternErrorMessage": "An absolute path, or one from ~/",
          "markdownDescription": "The client certificate's key in PEM, as q's `SSL_KEY_FILE`. An encrypted key's passphrase is kept by **kdb+/q: Set Certificate Passphrase**."
        },
        "kdb-q-ext-vscode.consoleSize": {
          "type": "array",
          "default": [
            1000,
            1000
          ],
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "integer",
            "minimum": 10,
            "maximum": 2000
          },
          "markdownDescription": "How much of a result **Run File on Server** and **Run Selected Text on Server** show, as lines then width, as q's `\\c` takes them. A result with more lines shows the first of them and then `..`, and a wider line is cut, ending in `..`."
        },
        "kdb-q-ext-vscode.precision": {
          "type": "integer",
          "default": 7,
          "minimum": 0,
          "maximum": 17,
          "markdownDescription": "How many significant digits **Run File on Server** and **Run Selected Text on Server** write floats and reals to, as q's `\\P` takes them, in the Console, the Grid, Copy, Export to CSV and the Chart's values at the cursor. 0 writes as many as each holds: 17 for a float, 8 for a real."
        },
        "kdb-q-ext-vscode.sizeLimit": {
          "type": "number",
          "default": 100,
          "exclusiveMinimum": 0,
          "markdownDescription": "The largest result to take, in megabytes, as q sends it, uncompressed. A larger one is refused before it's read, and the connection closed."
        },
        "kdb-q-ext-vscode.rowLimit": {
          "type": "integer",
          "default": 5000000,
          "minimum": 1,
          "markdownDescription": "The most rows a result, or a cell's value drilled into, can have to be shown; one with more is refused. The **kdb+/q** tab, and each kept tab, has about 4 GB of memory, and its Grid takes about 250 bytes a row, whatever the columns, and a mixed list's items up to about 200 bytes more each. A tab that runs out turns grey, while VS Code and other extensions carry on."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run clean && node esbuild.mjs --production",
    "clean": "node -e \"for (const d of ['out', 'dist']) require('node:fs').rmSync(d, { recursive: true, force: true })\"",
    "compile": "npm run clean && tsc -p ./ && node esbuild.mjs",
    "watch:esbuild": "node esbuild.mjs --watch",
    "watch:tsc": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "biome check && tsc -p tsconfig.web.json",
    "test": "vscode-test",
    "package": "vsce package",
    "format": "biome check --write",
    "fixtures": "cd test/fixtures && q fixtures.q -q",
    "fuzz": "npm run compile && node test/fuzz/fuzz.js"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.19.2",
    "@types/vscode": "1.140.0",
    "@vscode/codicons": "0.0.46-24",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "ag-grid-community": "36.2.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "uplot": "^1.6.32",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  }
}
