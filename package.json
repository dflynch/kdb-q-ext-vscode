{
  "name": "kdb-q-ext-vscode",
  "displayName": "Quirk: kdb+/q toolkit",
  "description": "A lightweight extension for kdb+/q programming",
  "icon": "./icons/quirk.png",
  "version": "1.1.0",
  "publisher": "dflynch3",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/dflynch/kdb-q-ext-vscode"
  },
  "engines": {
    "vscode": "^1.140.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "q",
        "extensions": [
          ".q"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/q-light.svg",
          "dark": "./icons/q-dark.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "q",
        "scopeName": "source.q",
        "path": "./syntaxes/q.tmGrammar.json"
      }
    ],
    "commands": [
      {
        "command": "kdb-q-ext-vscode.runSelectedText",
        "category": "kdb+/q",
        "title": "Run Selected Text"
      },
      {
        "command": "kdb-q-ext-vscode.toggleBlockComment",
        "category": "kdb+/q",
        "title": "Toggle Block Comment"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "kdb-q-ext-vscode.runSelectedText",
          "when": "editorLangId == q"
        },
        {
          "command": "kdb-q-ext-vscode.toggleBlockComment",
          "when": "!editorReadonly && editorLangId == q"
        }
      ]
    },
    "keybindings": [
      {
        "command": "kdb-q-ext-vscode.runSelectedText",
        "key": "ctrl+enter",
        "mac": "cmd+enter",
        "when": "editorTextFocus && editorLangId == q"
      },
      {
        "command": "kdb-q-ext-vscode.toggleBlockComment",
        "key": "shift+alt+a",
        "when": "editorTextFocus && !editorReadonly && editorLangId == q"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "clean": "node -e \"require('node:fs').rmSync('out', { recursive: true, force: true })\"",
    "compile": "npm run clean && tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "biome check && tsc -p tsconfig.web.json",
    "test": "vscode-test",
    "package": "vsce package",
    "format": "biome check --write",
    "fixtures": "cd test/fixtures && q fixtures.q -q"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.19.2",
    "@types/vscode": "1.140.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "typescript": "^7.0.2",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  }
}
