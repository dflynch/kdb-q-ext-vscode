{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "ES2024" /* VS Code >= 1.140 runs Node 24 */,
    "outDir": "out",
    "lib": ["ES2024"],
    "types": ["node", "mocha", "vscode"],
    "sourceMap": true,
    "rootDir": "src",
    "strict": true /* enable all strict type-checking options */,
    "skipLibCheck": true /* vscode-oniguruma's types need the DOM WebAssembly namespace */,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  // The webview's script, its grid and its chart have the DOM and no Node:
  // tsconfig.web.json checks them
  "exclude": [
    "src/webview/main.ts",
    "src/webview/grid.ts",
    "src/webview/chart/chart.ts",
    "src/webview/chart/panel.ts"
  ]
}
