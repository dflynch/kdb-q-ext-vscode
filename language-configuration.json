{
  "brackets": [["{", "}"], ["[", "]"], ["(", ")"]],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "notIn": ["string"] }
  ],
  "surroundingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "notIn": ["string"] }
  ],
  "comments": {
    "lineComment": "/"
  },
  "onEnterRules": [
    {
      "beforeText": "[{\\[(]\\s*$",
      "afterText": "^\\s*[}\\])]",
      "action": { "indent": "indent" }
    }
  ],
  "folding": {
    "markers": { "start": "^/\\s*$", "end": "^\\\\\\s*$" }
  },
  "wordPattern": "(?:\\.?[A-Za-z][A-Za-z0-9_]*(?:\\.[A-Za-z0-9_]+)*|(?<=`)[.:/\\w]+)"
}
