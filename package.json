{
  "name": "kdb-q-ext-vscode",
  "displayName": "kdb-q-ext-vscode",
  "description": "A lightweight extension for kdb+/q programming",
  "icon": "./icons/purple-q.png",
  "version": "1.0.2",
  "publisher": "dflynch3",
  "repository": {
    "type": "git",
    "url": "https://github.com/dflynch/kdb-q-ext-vscode"
  },
  "engines": {
    "vscode": "^1.140.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "q",
        "extensions": [
          ".q"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/purple-q.svg",
          "dark": "./icons/purple-q.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "q",
        "scopeName": "source.q",
        "path": "./syntaxes/q.tmGrammar.json"
      }
    ],
    "commands": [
      {
        "command": "kdb-q-ext-vscode.runSelectedText",
        "category": "kdb+/q",
        "title": "Run Selected Text"
      }
    ],
    "keybindings": [
      {
        "command": "kdb-q-ext-vscode.runSelectedText",
        "key": "ctrl+enter",
        "mac": "cmd+enter",
        "when": "editorTextFocus && editorLangId == q"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "biome check",
    "test": "vscode-test",
    "package": "vsce package",
    "format": "biome check --write"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.19.2",
    "@types/vscode": "1.140.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "typescript": "^7.0.2",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  }
}
